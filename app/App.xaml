<Application x:Class="WinSwitch.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Flat rounded buttons everywhere, instead of Windows' old raised grey ones; Primary is the accent-filled main action -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D3D8DF" /><Setter Property="Foreground" Value="#1B1E24" /><Setter Property="Padding" Value="14,5" /><Setter Property="Margin" Value="0,0,8,4" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="#F2F6FB" /><Setter TargetName="face" Property="BorderBrush" Value="#B9C6D8" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="face" Property="Background" Value="#E4ECF6" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="#2F7FD8" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="face" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2F7FD8" /><Setter Property="BorderBrush" Value="#2F7FD8" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="#2A72C2" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="face" Property="Background" Value="#2465AD" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="face" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
